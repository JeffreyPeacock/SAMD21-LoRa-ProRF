# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# NOT lib/ -- that is PlatformIO's home for OUR shared libraries and is
# committed. Third-party code is pinned in platformio.ini and fetched by
# PlatformIO into .pio/libdeps/, which .pio/ already covers.

# Generated by `make ide` (pio project init --ide clion) for indexing only.
# Derived files: regenerate, never edit, never commit.
CMakeLists.txt
CMakeListsPrivate.txt
cmake-build-*/

# Vendor documents: not licensed for redistribution. docs/assets records
# provenance instead.
docs/datasheets/
etc/firmware/

# Editors. JetBrains project state is kept SELECTIVELY, not excluded wholesale:
# shared CLion config -- run configurations, code style, project structure --
# is genuinely useful to someone picking the project up, so it is committed.
# What is excluded below is the per-user and per-machine state, which carries
# absolute paths and window positions and means nothing to anyone else.
#
# .idea/.gitignore is generated by the IDE and is meant to be committed.
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/misc.xml
.idea/modules.xml
.idea/*.iml
.idea/.name
.vscode/
*.swp
*~

# Claude Code
.claude_artifacts/
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/

# Captured logs from the board
*.log
!docs/**/*.log
